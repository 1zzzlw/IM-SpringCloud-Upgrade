              <mxPoint x="360" y="615" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 发送MQ -> MQ Exchange -->
        <mxCell id="e-mq" value="convertAndSend" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=9;strokeColor=#d79b00;fontStyle=2;" edge="1" parent="1" source="n-send-mq" target="n-mq-exchange">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MQ Exchange -> Queue -->
        <mxCell id="e-mq2" value="im.redpacket.grab" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=8;strokeColor=#d79b00;" edge="1" parent="1" source="n-mq-exchange" target="n-mq-queue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 同步写record -> DB -->
        <mxCell id="e-db-record" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=9;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="n-sync-write" target="n-db-record">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MQ send -> sync write -->
        <mxCell id="e-sync" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n-send-mq" target="n-sync-write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- sync write -> check done -->
        <mxCell id="e-check" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n-sync-write" target="n-check-done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- check done 是 -> update status -->
        <mxCell id="e-done-yes" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=9;strokeColor=#82b366;" edge="1" parent="1" source="n-check-done" target="n-update-status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- check done 否 -> return -->
        <mxCell id="e-done-no" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;fontSize=9;strokeColor=#82b366;" edge="1" parent="1" source="n-check-done" target="n-return">
          <mxGeometry relative="1" as="geometry">

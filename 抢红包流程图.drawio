        <mxCell id="ep2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n-pay-lock" target="n-pay-add">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n-pay-add" target="n-pay-record">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- im-pay -> DB edges -->
        <mxCell id="e-db-wallet" value="UPDATE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=8;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="n-pay-add" target="n-db-wallet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-db-wrec" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=8;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="n-pay-record" target="n-db-wrecord">
          <mxGeometry relative="1" as="geometry" />

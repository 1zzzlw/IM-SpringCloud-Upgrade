        <!-- MQ Queue -> im-pay consumer -->
        <mxCell id="e-mq-consume" value="@RabbitListener" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=9;strokeColor=#d79b00;fontStyle=2;" edge="1" parent="1" source="n-mq-queue" target="n-consume">
          <mxGeometry relative="1" as="geometry" />

          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 金额校验 通过 -> 查询帖子 -->
        <mxCell id="e2" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=9;strokeColor=#82b366;" edge="1" parent="1" source="n2-check" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 查询帖子 -> DB -->
        <mxCell id="e-db-moments" value="SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=8;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="n3" target="n-db-moments">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 查询完成 -> 自查校验 -->
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n-self-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 是自己 -> 报错 -->
        <mxCell id="e-self" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="n-self-check" target="n-self-fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 不是自己 -> 生成幂等Key -->
        <mxCell id="e4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=9;strokeColor=#82b366;" edge="1" parent="1" source="n-self-check" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 生成幂等 -> 发送MQ -->
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 发送MQ -> MQ Exchange -->
        <mxCell id="e-mq1" value="convertAndSend&#xa;im.reward.create" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=8;strokeColor=#d79b00;fontStyle=2;" edge="1" parent="1" source="n5" target="n-mq-exchange">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Exchange -> Create Queue -->
        <mxCell id="e-mq2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n-mq-exchange" target="n-mq-create">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Create Queue -> im-pay consume -->
        <mxCell id="e-mq-consume" value="@RabbitListener" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=9;strokeColor=#d79b00;fontStyle=2;" edge="1" parent="1" source="n-mq-create" target="n-pay-consume">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- im-pay internal flow -->
        <mxCell id="ep1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n-pay-consume" target="n-idempotent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep2" value="首次" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=9;strokeColor=#82b366;" edge="1" parent="1" source="n-idempotent" target="n-transfer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep2b" value="已消费" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=1;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="n-idempotent" target="n-idempotent">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="648" />
              <mxPoint x="590" y="648" />
              <mxPoint x="590" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ep3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n-transfer" target="n-deadlock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n-deadlock" target="n-deduct">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n-deduct" target="n-add">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep6" value="写流水 type=3 + type=4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=8;strokeColor=#82b366;" edge="1" parent="1" source="n-add" target="n-send-result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- im-pay -> DB edges -->
        <mxCell id="e-db-wf" value="FOR UPDATE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=8;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="n-deadlock" target="n-db-wallet-from">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-db-wt" value="UPDATE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=8;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="n-add" target="n-db-wallet-to">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-db-out" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.2;entryX=1;entryY=0.5;fontSize=8;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="n-add" target="n-db-record-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-db-in" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.8;entryX=1;entryY=0.5;fontSize=8;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="n-add" target="n-db-record-in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 发送结果 -> MQ Result Queue -->
        <mxCell id="e-mq-result" value="convertAndSend&#xa;im.reward.result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=8;strokeColor=#d79b00;fontStyle=2;" edge="1" parent="1" source="n-send-result" target="n-mq-result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Result Queue -> im-moments callback -->
        <mxCell id="e-mq-callback" value="@RabbitListener" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=9;strokeColor=#d79b00;fontStyle=2;" edge="1" parent="1" source="n-mq-result" target="n-callback">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- callback -> result check -->
        <mxCell id="e-cb1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n-callback" target="n-result-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 成功 -> 更新DB -->
        <mxCell id="e-cb-success" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=9;strokeColor=#82b366;" edge="1" parent="1" source="n-result-check" target="n-success-update">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 失败 -> 记录日志 -->
        <mxCell id="e-cb-fail" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=1;entryX=0.5;entryY=0;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="n-result-check" target="n-fail-log">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="875" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 更新DB -> DB -->
        <mxCell id="e-db-update" value="UPDATE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=8;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="n-success-update" target="n-db-moments-update">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 返回客户端 -->
        <mxCell id="e-client-end" value="通知结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=9;strokeColor=#82b366;" edge="1" parent="1" source="n-success-update" target="n-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

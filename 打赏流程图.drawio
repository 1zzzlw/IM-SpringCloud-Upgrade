<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="打赏流程">
    <mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="打赏流程 — Reward / Tip" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="5" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Swimlane: 客户端 -->
        <mxCell id="lane-client" value="客户端" style="swimlane;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="40" width="170" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="打赏帖子&#xa;(momentId, amount)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="lane-client">
          <mxGeometry x="10" y="50" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n-end" value="收到打赏结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="lane-client">
          <mxGeometry x="10" y="1000" width="150" height="40" as="geometry" />
        </mxCell>

        <!-- Swimlane: im-moments -->
        <mxCell id="lane-moments" value="im-moments (打赏发起方)" style="swimlane;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="40" width="190" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="n2-check" value="校验金额范围&#xa;0.01 ≤ amount ≤ 200" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="lane-moments">
          <mxGeometry x="20" y="45" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n2-fail" value="金额不合法&#xa;返回错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="lane-moments">
          <mxGeometry x="20" y="125" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="查询帖子获取作者ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="lane-moments">
          <mxGeometry x="20" y="195" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n-self-check" value="打赏自己?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="lane-moments">
          <mxGeometry x="25" y="260" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-self-fail" value="不能给自己打赏&#xa;返回错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="lane-moments">
          <mxGeometry x="20" y="335" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="生成幂等Key&#xa;{fromUserId}_{momentId}_{ts}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="lane-moments">
          <mxGeometry x="20" y="405" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="发送打赏请求 MQ&#xa;RewardMessageDTO&#xa;→ im.reward.create" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;fontStyle=1;" vertex="1" parent="lane-moments">
          <mxGeometry x="20" y="475" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n-done-label" value="--- 异步回调 ---" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=9;fontColor=#666666;fontStyle=2;" vertex="1" parent="lane-moments">
          <mxGeometry x="20" y="700" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n-callback" value="RewardResultListener&#xa;消费结果 MQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="lane-moments">
          <mxGeometry x="20" y="730" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n-result-check" value="打赏成功?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="lane-moments">
          <mxGeometry x="25" y="800" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-success-update" value="更新 moments 表&#xa;reward_amount 字段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="lane-moments">
          <mxGeometry x="20" y="880" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n-fail-log" value="记录错误日志&#xa;(运营人工处理)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="lane-moments">
          <mxGeometry x="20" y="950" width="150" height="40" as="geometry" />
        </mxCell>

        <!-- Swimlane: RabbitMQ -->
        <mxCell id="lane-mq" value="RabbitMQ" style="swimlane;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="40" width="180" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="n-mq-exchange" value="Exchange:&#xa;im-topic-exchange&#xa;(持久化 Topic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="lane-mq">
          <mxGeometry x="10" y="475" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n-mq-create" value="创建队列:&#xa;im-reward-create-queue&#xa;(routing: im.reward.create)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="lane-mq">
          <mxGeometry x="10" y="555" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n-mq-result" value="结果队列:&#xa;im-reward-result-queue&#xa;(routing: im.reward.result)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="lane-mq">
          <mxGeometry x="10" y="730" width="160" height="55" as="geometry" />
        </mxCell>

        <!-- Swimlane: im-pay -->
        <mxCell id="lane-pay" value="im-pay (资金处理方)" style="swimlane;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="210" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="n-pay-consume" value="RewardMessageListener&#xa;消费打赏请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="lane-pay">
          <mxGeometry x="15" y="555" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n-idempotent" value="🔒 Redisson SetNX 幂等校验&#xa;key=&quot;reward:&quot;+idempotentKey&#xa;TTL=300s 防重复消费" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=8;fontStyle=1;" vertex="1" parent="lane-pay">
          <mxGeometry x="15" y="620" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n-transfer" value="transferForReward()&#xa;@Transactional 转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=1;" vertex="1" parent="lane-pay">
          <mxGeometry x="15" y="700" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n-deadlock" value="按 userId 升序锁定&#xa;(防死锁):&#xa;SELECT FOR UPDATE min(Id)&#xa;SELECT FOR UPDATE max(Id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=8;fontStyle=1;" vertex="1" parent="lane-pay">
          <mxGeometry x="15" y="770" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n-deduct" value="乐观扣款&#xa;UPDATE SET bal=bal-amt&#xa;WHERE bal &gt;= amt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=1;" vertex="1" parent="lane-pay">
          <mxGeometry x="15" y="855" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-add" value="到账: UPDATE SET&#xa;bal=bal+amt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="lane-pay">
          <mxGeometry x="15" y="930" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n-send-result" value="发送结果 MQ&#xa;RewardResultDTO&#xa;→ im.reward.result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;fontStyle=1;" vertex="1" parent="lane-pay">
          <mxGeometry x="15" y="1000" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- Swimlane: MySQL -->
        <mxCell id="lane-mysql" value="MySQL" style="swimlane;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="40" width="190" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="n-db-moments" value="moments 表&#xa;(帖子主表)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="lane-mysql">
          <mxGeometry x="20" y="195" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n-db-wallet-from" value="wallet 表 (发送方)&#xa;balance 扣减" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="lane-mysql">
          <mxGeometry x="20" y="855" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n-db-wallet-to" value="wallet 表 (接收方)&#xa;balance 到账" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="lane-mysql">
          <mxGeometry x="20" y="930" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n-db-record-out" value="wallet_record 表&#xa;流水 type=3 打赏支出" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="lane-mysql">
          <mxGeometry x="20" y="1000" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-db-record-in" value="wallet_record 表&#xa;流水 type=4 打赏收入" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="lane-mysql">
          <mxGeometry x="20" y="1060" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-db-moments-update" value="moments 表&#xa;UPDATE reward_amount" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="lane-mysql">
          <mxGeometry x="20" y="880" width="150" height="55" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->

        <!-- 客户端 -> 校验金额 -->
        <mxCell id="e1" value="HTTP POST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=9;strokeColor=#6c8ebf;" edge="1" parent="1" source="n1" target="n2-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 金额校验 失败 -->

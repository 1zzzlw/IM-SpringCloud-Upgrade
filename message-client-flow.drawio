<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="多客户端消息流转">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ====== 5 SWIMLANES for 5 participants ====== -->

        <!-- Lane 1: User A (Sender) -->
        <mxCell id="lane-a" value="🟢 用户A — 发送方客户端" style="swimlane;startSize=28;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="10" width="300" height="1420" as="geometry" />
        </mxCell>

        <!-- Lane 2: Server (Netty + Routing) -->
        <mxCell id="lane-srv" value="🔵 服务端 — im-server Netty" style="swimlane;startSize=28;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="10" width="280" height="1420" as="geometry" />
        </mxCell>

        <!-- Lane 3: Infrastructure (MQ + DB + Redis) -->
        <mxCell id="lane-infra" value="🟠 中间件 — MQ + 存储" style="swimlane;startSize=28;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="10" width="240" height="1420" as="geometry" />
        </mxCell>

        <!-- Lane 4: User B (Private Chat Receiver) -->
        <mxCell id="lane-b" value="🔴 用户B — 私聊接收方客户端" style="swimlane;startSize=28;fillColor=#FCE4EC;strokeColor=#C62828;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="10" width="300" height="1420" as="geometry" />
        </mxCell>

        <!-- Lane 5: User C (Group Chat Receiver) -->
        <mxCell id="lane-c" value="🟣 用户C — 群聊接收方客户端" style="swimlane;startSize=28;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1170" y="10" width="300" height="1420" as="geometry" />
        </mxCell>

        <!-- ====== SECTION TITLES (across all lanes, parent=1) ====== -->
        <mxCell id="sec1-title" value="&lt;b&gt;═══ 场景一：私聊 — 用户A发送文本消息给在线用户B ═══&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="240" y="45" width="900" height="22" as="geometry" />
        </mxCell>

        <mxCell id="sec2-title" value="&lt;b&gt;═══ 场景二：群聊 — 用户A发送消息给群组 (成员B在线, 成员C离线) ═══&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#7B1FA2;" vertex="1" parent="1">
          <mxGeometry x="180" y="575" width="1100" height="22" as="geometry" />
        </mxCell>

        <mxCell id="sec3-title" value="&lt;b&gt;═══ 场景三：文件上传 — 用户A发送文件消息给用户B ═══&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="240" y="1025" width="850" height="22" as="geometry" />
        </mxCell>

        <!-- ================================================================== -->
        <!-- SCENE 1: PRIVATE CHAT A -> B (y=70 ~ 540)                          -->
        <!-- ================================================================== -->

        <!-- - USER A STACK (lane-a, x rel: 10-40) - -->
        <mxCell id="a1-input" value="✏️ ChatBase.vue&#xa;用户输入消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;arcSize=8;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="45" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a1-pinia" value="&lt;b&gt;Pinia MessageStore&lt;/b&gt;&#xa;_sendOutgoing()&#xa;雪花ID → pending追踪" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=9;arcSize=8;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="110" width="165" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a1-sqlite" value="&lt;b&gt;SQLite 本地写&lt;/b&gt;&#xa;message 表&#xa;sendStatus=0(发送中)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#81C784;strokeColor=#2E7D32;fontSize=9;arcSize=8;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="185" width="165" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a1-ipc" value="&lt;b&gt;IPC → Main Process&lt;/b&gt;&#xa;contextBridge&#xa;wsApi.sendMessage()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=9;arcSize=8;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="255" width="165" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a1-ws" value="&lt;b&gt;WebSocket 发送&lt;/b&gt;&#xa;protocol.js 编码&#xa;16B头 + JSON body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=9;arcSize=8;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="325" width="165" height="50" as="geometry" />
        </mxCell>

        <!-- ACK receive (A side) -->
        <mxCell id="a1-ack" value="✅ 收到ACK(16)&#xa;sendStatus=1&#xa;SQLite 更新状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=9;arcSize=8;dashed=1;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="420" width="165" height="50" as="geometry" />
        </mxCell>

        <!-- - SERVER STACK (lane-srv, x rel: 10-40) - -->
        <mxCell id="s1-decode" value="&lt;b&gt;Netty Pipeline 解码&lt;/b&gt;&#xa;BinaryWSFrame → ByteBuf&#xa;ProtocolFrameDecoder&#xa;MessageCodecSharable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=9;arcSize=8;" vertex="1" parent="lane-srv">
          <mxGeometry x="20" y="80" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s1-dispatch" value="&lt;b&gt;MessageDispatcherHandler&lt;/b&gt;&#xa;type=1 → PrivateChatHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#1565C0;fontSize=9;arcSize=8;" vertex="1" parent="lane-srv">
          <mxGeometry x="20" y="165" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s1-handler" value="&lt;b&gt;PrivateChatHandler&lt;/b&gt;&#xa;取发送者 → 构建VO&#xa;发ACK(16)给A&#xa;返回MessageResult" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#1565C0;fontSize=9;arcSize=8;" vertex="1" parent="lane-srv">
          <mxGeometry x="20" y="230" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s1-route" value="&lt;b&gt;MQMessagePublish&lt;/b&gt;&#xa;sendToCluster()&#xa;Redis HASH 查集群映射" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64B5F6;strokeColor=#1565C0;fontSize=9;arcSize=8;" vertex="1" parent="lane-srv">
          <mxGeometry x="20" y="310" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s1-choice" value="B在线?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="lane-srv">
          <mxGeometry x="35" y="380" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s1-local" value="在线: channel.writeAndFlush()&#xa;直接推送给B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=9;arcSize=8;" vertex="1" parent="lane-srv">
          <mxGeometry x="20" y="475" width="170" height="45" as="geometry" />
        </mxCell>

        <!-- - INFRASTRUCTURE (lane-infra, x rel: 10-30) - -->
        <mxCell id="i1-mq" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&#xa;im-topic-exchange&#xa;→ im-storage-queue&#xa;(异步持久化)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=9;arcSize=8;" vertex="1" parent="lane-infra">
          <mxGeometry x="15" y="150" width="150" height="65" as="geometry" />
        </mxCell>
        <mxCell id="i1-mysql" value="&lt;b&gt;im-chat MQ消费&lt;/b&gt;&#xa;INSERT IGNORE&#xa;→ MySQL message 表&#xa;→ 更新会话未读数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=9;arcSize=8;" vertex="1" parent="lane-infra">
          <mxGeometry x="15" y="240" width="150" height="65" as="geometry" />
        </mxCell>
        <mxCell id="i1-redis" value="&lt;b&gt;Redis&lt;/b&gt;&#xa;集群映射 HASH&#xa;在线状态 SET" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#B71C1C;fontSize=9;size=10;" vertex="1" parent="lane-infra">
          <mxGeometry x="20" y="340" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- - USER B STACK (lane-b, x rel: 10-40) - -->
        <mxCell id="b1-ws" value="&lt;b&gt;WebSocket 接收&lt;/b&gt;&#xa;Main: onMessage()&#xa;protocol.js 解码&#xa;→ IPC 广播到Renderer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#C62828;fontSize=9;arcSize=8;" vertex="1" parent="lane-b">
          <mxGeometry x="20" y="80" width="165" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b1-handler" value="&lt;b&gt;wsHandlers 分发&lt;/b&gt;&#xa;messageType=2 →&#xa;handleIncomingMessage()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F48FB1;strokeColor=#C62828;fontSize=9;arcSize=8;" vertex="1" parent="lane-b">
          <mxGeometry x="20" y="160" width="165" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b1-pinia" value="&lt;b&gt;Pinia MessageStore&lt;/b&gt;&#xa;addMessageMap()&#xa;追加到 messageMap[convId]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F48FB1;strokeColor=#C62828;fontSize=9;arcSize=8;" vertex="1" parent="lane-b">
          <mxGeometry x="20" y="230" width="165" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b1-sqlite" value="&lt;b&gt;SQLite 存储&lt;/b&gt;&#xa;Main进程直接写入&#xa;INSERT OR REPLACE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F48FB1;strokeColor=#C62828;fontSize=9;arcSize=8;" vertex="1" parent="lane-b">
          <mxGeometry x="20" y="300" width="165" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b1-ui" value="🖥️ &lt;b&gt;UI 渲染&lt;/b&gt;&#xa;ChatBase.vue 响应式更新&#xa;MessageContentManage 分发&#xa;(文本/图片/语音/视频/文件)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F48FB1;strokeColor=#C62828;fontSize=9;arcSize=8;" vertex="1" parent="lane-b">
          <mxGeometry x="20" y="370" width="165" height="60" as="geometry" />
        </mxCell>

        <!-- ================================================================== -->
        <!-- SCENE 2: GROUP CHAT A -> B + C (y=600 ~ 980)                      -->
        <!-- ================================================================== -->

        <!-- - USER A group chat send (lane-a) - -->
        <mxCell id="a2-input" value="✏️ ChatBase.vue (群聊)&#xa;用户输入群消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;arcSize=8;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="605" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a2-pinia" value="&lt;b&gt;Pinia MessageStore&lt;/b&gt;&#xa;_sendOutgoing()&#xa;wsType=3 (群聊)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=9;arcSize=8;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="670" width="165" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a2-ws" value="&lt;b&gt;WebSocket 发送&lt;/b&gt;&#xa;protocol.js 编码&#xa;type=3 (GroupChatRequest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=9;arcSize=8;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="735" width="165" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a2-ack" value="✅ 收到ACK(16)&#xa;sendStatus=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=9;arcSize=8;dashed=1;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="830" width="165" height="40" as="geometry" />
        </mxCell>

        <!-- - SERVER group chat (lane-srv) - -->
        <mxCell id="s2-handler" value="&lt;b&gt;GroupChatHandler&lt;/b&gt;&#xa;解析群成员列表&#xa;→ MessageResult.multiple(&#xa;  response, [B, C])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#1565C0;fontSize=9;arcSize=8;" vertex="1" parent="lane-srv">
          <mxGeometry x="15" y="620" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s2-route" value="&lt;b&gt;MQMessagePublish&lt;/b&gt;&#xa;批量查Redis集群映射:&#xa;HASH multiGet [B, C]&#xa;→ 三向路由分发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64B5F6;strokeColor=#1565C0;fontSize=9;arcSize=8;" vertex="1" parent="lane-srv">
          <mxGeometry x="15" y="705" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2-choice-b" value="B?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="lane-srv">
          <mxGeometry x="50" y="785" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2-push-b" value="在线: 推送B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=9;arcSize=8;" vertex="1" parent="lane-srv">
          <mxGeometry x="20" y="860" width="80" height="35" as="geometry" />
        </mxCell>
        <mxCell id="s2-choice-c" value="C?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="lane-srv">
          <mxGeometry x="120" y="785" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2-offline-c" value="离线: Lua ZADD&#xa;Redis ZSet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#B71C1C;fontSize=9;arcSize=8;" vertex="1" parent="lane-srv">
          <mxGeometry x="110" y="860" width="80" height="35" as="geometry" />
        </mxCell>

        <!-- - INFRASTRUCTURE group (lane-infra) - -->
        <mxCell id="i2-mq-storage" value="&lt;b&gt;MQ im.storage&lt;/b&gt;&#xa;→ im-storage-queue&#xa;→ im-chat 消费&#xa;INSERT IGNORE MySQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=9;arcSize=8;" vertex="1" parent="lane-infra">
          <mxGeometry x="15" y="630" width="155" height="65" as="geometry" />
        </mxCell>
        <mxCell id="i2-redis-offline" value="&lt;b&gt;Redis&lt;/b&gt;&#xa;离线消息 ZSet&#xa;user:offline:message:&#xa;content:{userId}" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#B71C1C;fontSize=8;size=10;" vertex="1" parent="lane-infra">
          <mxGeometry x="20" y="780" width="145" height="65" as="geometry" />
        </mxCell>
        <mxCell id="i2-canal" value="&lt;b&gt;C从离线到上线&lt;/b&gt;&#xa;ConnectSuccessHandler&#xa;→ ZRANGE + DEL&#xa;→ 推送离线消息给C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=9;arcSize=8;dashed=1;" vertex="1" parent="lane-infra">
          <mxGeometry x="15" y="870" width="155" height="65" as="geometry" />
        </mxCell>

        <!-- - USER B group receive (lane-b) - -->
        <mxCell id="b2-ws" value="&lt;b&gt;WebSocket 接收&lt;/b&gt;&#xa;messageType=4&#xa;(GroupChatResponseVO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#C62828;fontSize=9;arcSize=8;" vertex="1" parent="lane-b">
          <mxGeometry x="20" y="620" width="165" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b2-handler" value="&lt;b&gt;wsHandlers&lt;/b&gt;&#xa;type=4 → handleIncoming&#xa;→ Pinia → SQLite → UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F48FB1;strokeColor=#C62828;fontSize=9;arcSize=8;" vertex="1" parent="lane-b">
          <mxGeometry x="20" y="690" width="165" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b2-ui" value="🖥️ UI渲染群消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F48FB1;strokeColor=#C62828;fontSize=9;arcSize=8;" vertex="1" parent="lane-b">
          <mxGeometry x="20" y="760" width="165" height="35" as="geometry" />
        </mxCell>

        <!-- - USER C group receive (lane-c) - -->
        <mxCell id="c-offline" value="&lt;b&gt;❌ 用户C当前离线&lt;/b&gt;&#xa;消息暂存Redis ZSet&#xa;等待上线后推送" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;fontSize=9;arcSize=8;dashed=1;" vertex="1" parent="lane-c">
          <mxGeometry x="20" y="620" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c-online" value="&lt;b&gt;用户C上线&lt;/b&gt;&#xa;HandshakeComplete&#xa;→ 推离线消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#7B1FA2;fontSize=9;arcSize=8;dashed=1;" vertex="1" parent="lane-c">
          <mxGeometry x="20" y="700" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c-ws" value="&lt;b&gt;WebSocket 接收&lt;/b&gt;&#xa;收到离线群消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#7B1FA2;fontSize=9;arcSize=8;" vertex="1" parent="lane-c">
          <mxGeometry x="20" y="770" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c-pinia" value="&lt;b&gt;Pinia → SQLite → UI&lt;/b&gt;&#xa;同B的接收流程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#7B1FA2;fontSize=9;arcSize=8;" vertex="1" parent="lane-c">
          <mxGeometry x="20" y="835" width="170" height="45" as="geometry" />
        </mxCell>

        <!-- ================================================================== -->
        <!-- SCENE 3: FILE UPLOAD A -> B (y=1050 ~ 1380)                       -->
        <!-- ================================================================== -->

        <!-- - USER A file select + upload (lane-a) - -->
        <mxCell id="a3-select" value="📎 用户A选择文件/截图&#xa;filterFileKind() 分类&#xa;(Image/Voice/Video/File)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=9;arcSize=8;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="1055" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a3-fileinfo" value="&lt;b&gt;getFileInfo() Main&lt;/b&gt;&#xa;MD5 → fileId&#xa;base64预览(图片/视频)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=9;arcSize=8;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="1130" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a3-chunk" value="&lt;b&gt;分块上传引擎&lt;/b&gt;&#xa;5MB/块 Piscina线程池&#xa;MessageQueue并发=2&#xa;断点续传 (checkUploaded)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=9;arcSize=8;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="1200" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a3-sendfile" value="&lt;b&gt;上传完成 → 发送WS消息&lt;/b&gt;&#xa;sendFileMessage()&#xa;携带MinIO文件路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=9;arcSize=8;" vertex="1" parent="lane-a">
          <mxGeometry x="20" y="1285" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- - SERVER file handling (lane-srv) - -->
        <mxCell id="s3-rest" value="&lt;b&gt;MessageController REST&lt;/b&gt;&#xa;1. verifyUploadToken (Redis凭证)&#xa;2. uploadChunk ×N (MinIO分块)&#xa;3. checkUploaded (断点)&#xa;4. mergeFile (合并清理)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=9;arcSize=8;" vertex="1" parent="lane-srv">
          <mxGeometry x="15" y="1055" width="175" height="80" as="geometry" />
        </mxCell>

        <!-- - INFRASTRUCTURE MinIO + DB (lane-infra) - -->
        <mxCell id="i3-minio" value="&lt;b&gt;MinIO 对象存储&lt;/b&gt;&#xa;临时: file-chunk/{hash}/&#xa;最终: zzz-im-{bucket}/" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#B71C1C;fontSize=8;size=10;" vertex="1" parent="lane-infra">
          <mxGeometry x="15" y="1060" width="155" height="70" as="geometry" />
        </mxCell>
